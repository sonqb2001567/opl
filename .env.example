# Copy file này thành `.env` rồi điền giá trị thật.
# File `.env` KHÔNG được commit (đã nằm trong .gitignore).

# Kết nối MySQL. Tên database phải khớp với prisma/database-setup.sql
# Định dạng: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:your_password@localhost:3306/opl"

# Khoá bí mật để ký JWT. Đổi thành chuỗi random dài trước khi deploy.
JWT_SECRET="doi_thanh_chuoi_random_dai"

# Thời hạn token. Lưu ý: hiện code chưa đọc biến này -
# src/auth/auth.module.ts đang hard-code expiresIn: '1d'.
JWT_EXPIRES_IN="1d"

# Cổng chạy server (mặc định 3000 nếu không khai báo)
PORT=3000
