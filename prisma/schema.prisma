// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  ADMIN
  PRODUCT_STAFF
  INVENTORY_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  LOCKED 
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ON_SALE
  DISCONTINUED
}

enum InventoryTransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD 
  BANK_TRANSFER
  E_WALLET 
}

enum PaymentStatus {
  UNPAID 
  PAID
  FAILED 
  REFUNDED 
}

enum ReviewStatus {
  VISIBLE 
  HIDDEN 
}

enum VoucherStatus {
  ACTIVE 
  INACTIVE
}

model User {
  id          Int        @id @default(autoincrement()) @map("user_id")
  fullName    String     @map("full_name") @db.VarChar(100)
  email       String     @unique @db.VarChar(255)
  password    String     @db.VarChar(255)
  phoneNumber String?    @map("phone_number") @db.VarChar(20)
  address     String?    @db.Text
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  inventoryTransactions InventoryTransaction[] 
  orders                Order[]
  reviews               Review[]
  cart                  Cart?

  @@map("users")
}


model Category {
  id           Int            @id @default(autoincrement()) @map("category_id")
  categoryName String         @unique @map("category_name") @db.VarChar(100)
  status       CategoryStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement()) @map("product_id")
  categoryId  Int           @map("category_id")
  productName String        @map("product_name") @db.VarChar(255)
  skuCode     String        @unique @map("sku_code") @db.VarChar(50)
  price       Decimal       @db.Decimal(12, 2) // >= 0 (CHECK constraint)
  description String?       @db.Text
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  status      ProductStatus @default(ON_SALE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]
  orderDetails          OrderDetail[]
  reviews               Review[]
  cartItems             CartItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model InventoryTransaction {
  id              Int                      @id @default(autoincrement()) @map("transaction_id")
  productId       Int                      @map("product_id")
  staffId         Int                      @map("staff_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int // số lượng thay đổi
  reason          String?                  @db.Text // bắt buộc khi ADJUSTMENT
  createdAt       DateTime                 @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  staff   User    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([staffId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Order {
  id              Int           @id @default(autoincrement()) @map("order_id")
  customerId      Int           @map("customer_id")
  shippingAddress String        @map("shipping_address") @db.Text
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  cancelReason    String?       @map("cancel_reason") @db.Text // bắt buộc khi CANCELLED
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer     User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderDetails OrderDetail[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderDetail {
  id        Int     @id @default(autoincrement()) @map("order_detail_id")
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int // > 0
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2) // giá tại thời điểm đặt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId]) // 1 sản phẩm chỉ xuất hiện 1 dòng / đơn
  @@index([productId])
  @@map("order_details")
}

model Review {
  id         Int          @id @default(autoincrement()) @map("review_id")
  customerId Int          @map("customer_id")
  productId  Int          @map("product_id")
  rating     Int          @db.SmallInt // 1..5 (CHECK constraint)
  comment    String?      @db.Text
  status     ReviewStatus @default(VISIBLE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model Voucher {
  id            Int           @id @default(autoincrement()) @map("voucher_id")
  code          String        @unique @db.VarChar(50)
  discountValue Decimal       @map("discount_value") @db.Decimal(12, 2)
  conditions    String?       @db.Text // điều kiện áp dụng (vd: đơn tối thiểu 200k)
  validFrom     DateTime      @map("valid_from")
  validTo       DateTime      @map("valid_to")
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, validFrom, validTo])
  @@map("vouchers")
}

model Cart {
  id         Int      @id @default(autoincrement()) @map("cart_id")
  customerId Int      @unique @map("customer_id") // @unique => quan hệ 1-1
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer  User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement()) @map("cart_item_id")
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int @default(1) // > 0

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // thêm trùng sản phẩm => tăng quantity
  @@index([productId])
  @@map("cart_items")
}
