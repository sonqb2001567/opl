// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  ADMIN
  PRODUCT_STAFF
  INVENTORY_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  LOCKED 
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ON_SALE
  DISCONTINUED
}

enum InventoryTransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD 
  BANK_TRANSFER
  E_WALLET 
}

enum PaymentStatus {
  UNPAID 
  PAID
  FAILED 
  REFUNDED 
}

enum ReviewStatus {
  VISIBLE 
  HIDDEN 
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
}

// Loại mã OTP gửi qua email
enum VerificationCodeType {
  EMAIL_VERIFY   // xác thực email sau khi đăng ký
  PASSWORD_RESET // đặt lại mật khẩu khi quên
}

model User {
  id              Int        @id @default(autoincrement()) @map("user_id")
  fullName        String     @map("full_name") @db.VarChar(100)
  email           String     @unique @db.VarChar(255)
  password        String     @db.VarChar(255)
  phoneNumber     String?    @map("phone_number") @db.VarChar(20)
  address         String?    @db.Text
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  // null = email chưa xác thực OTP => chưa đăng nhập được
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  inventoryTransactions InventoryTransaction[]
  orders                Order[]
  reviews               Review[]
  cart                  Cart?
  verificationCodes     VerificationCode[]

  @@map("users")
}

// Mã OTP 6 số gửi qua email (xác thực email / đặt lại mật khẩu).
// Chỉ lưu bản băm bcrypt của mã, không lưu mã gốc.
model VerificationCode {
  id         Int                  @id @default(autoincrement()) @map("verification_code_id")
  userId     Int                  @map("user_id")
  type       VerificationCodeType
  codeHash   String               @map("code_hash") @db.VarChar(255)
  expiresAt  DateTime             @map("expires_at")
  consumedAt DateTime?            @map("consumed_at") // đã dùng thì không dùng lại được
  attempts   Int                  @default(0) // số lần nhập sai, quá 5 lần thì khoá mã
  createdAt  DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("verification_codes")
}

model Category {
  id           Int            @id @default(autoincrement()) @map("category_id")
  categoryName String         @unique @map("category_name") @db.VarChar(100)
  status       CategoryStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Quan hệ N-N với Product qua bảng trung gian product_categories
  productCategories ProductCategory[]

  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement()) @map("product_id")
  productName String        @map("product_name") @db.VarChar(255)
  skuCode     String        @unique @map("sku_code") @db.VarChar(50)
  price       Decimal       @db.Decimal(12, 2) // >= 0 (CHECK constraint)
  description String?       @db.Text
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  status      ProductStatus @default(ON_SALE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Quan hệ N-N với Category: 1 sản phẩm thuộc nhiều danh mục
  productCategories     ProductCategory[]
  inventoryTransactions InventoryTransaction[]
  orderDetails          OrderDetail[]
  reviews               Review[]
  cartItems             CartItem[]

  @@index([status])
  @@map("products")
}

// Bảng trung gian của quan hệ N-N Category <-> Product.
// Khoá chính ghép (product_id, category_id) nên không gán trùng được.
model ProductCategory {
  productId  Int      @map("product_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model InventoryTransaction {
  id              Int                      @id @default(autoincrement()) @map("transaction_id")
  productId       Int                      @map("product_id")
  staffId         Int                      @map("staff_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int // số lượng thay đổi
  reason          String?                  @db.Text // bắt buộc khi ADJUSTMENT
  createdAt       DateTime                 @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  staff   User    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([staffId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Order {
  id              Int           @id @default(autoincrement()) @map("order_id")
  customerId      Int           @map("customer_id")
  shippingAddress String        @map("shipping_address") @db.Text
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  cancelReason    String?       @map("cancel_reason") @db.Text // bắt buộc khi CANCELLED
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Quan hệ 1-1: mỗi đơn hàng có đúng 1 dòng chi tiết.
  // Giỏ hàng nhiều sản phẩm sẽ được tách thành nhiều đơn khi đặt hàng.
  orderDetail OrderDetail?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderDetail {
  id        Int     @id @default(autoincrement()) @map("order_detail_id")
  orderId   Int     @unique @map("order_id") // @unique => quan hệ 1-1 với Order
  productId Int     @map("product_id")
  quantity  Int // > 0
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2) // giá tại thời điểm đặt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("order_details")
}

model Review {
  id         Int          @id @default(autoincrement()) @map("review_id")
  customerId Int          @map("customer_id")
  productId  Int          @map("product_id")
  rating     Int          @db.SmallInt // 1..5 (CHECK constraint)
  comment    String?      @db.Text
  status     ReviewStatus @default(VISIBLE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model Voucher {
  id            Int           @id @default(autoincrement()) @map("voucher_id")
  code          String        @unique @db.VarChar(50)
  discountValue Decimal       @map("discount_value") @db.Decimal(12, 2)
  conditions    String?       @db.Text // điều kiện áp dụng (vd: đơn tối thiểu 200k)
  validFrom     DateTime      @map("valid_from")
  validTo       DateTime      @map("valid_to")
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, validFrom, validTo])
  @@map("vouchers")
}

model Cart {
  id         Int      @id @default(autoincrement()) @map("cart_id")
  customerId Int      @unique @map("customer_id") // @unique => quan hệ 1-1
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer  User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement()) @map("cart_item_id")
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int @default(1) // > 0

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // thêm trùng sản phẩm => tăng quantity
  @@index([productId])
  @@map("cart_items")
}
