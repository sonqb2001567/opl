# =====================================================================
# Biến môi trường cho Docker - copy file này thành .env.docker rồi sửa
#   cp .env.docker.example .env.docker
# Chạy: docker compose --env-file .env.docker up -d --build
#
# File .env.docker KHÔNG commit (đã có trong .gitignore).
# Đây là file riêng cho Docker, khác với .env dùng khi chạy npm run start:dev.
# =====================================================================

# Mật khẩu root của MySQL trong container. Đặt tuỳ ý ở lần deploy đầu tiên -
# sau khi volume mysql_data đã tạo thì đổi biến này sẽ KHÔNG đổi được mật khẩu nữa.

POSTGRES_PASSWORD=mat_khau_manh      # đổi tên biến, cũ là MYSQL_ROOT_PASSWORD

# Chuỗi ký tự ngẫu nhiên dài dùng để ký JWT. Đổi chuỗi này = mọi token cũ hết hiệu lực.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=doi_thanh_chuoi_random_dai

# Cổng mở ra ngoài trên server (bên trong container luôn là 3000)
APP_PORT=3000

# Trang tài liệu API. Production nên để false.
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

# Múi giờ cho cả app lẫn MySQL
TZ=Asia/Ho_Chi_Minh
